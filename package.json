{
  "name": "dsh-theme-thought-lite",
  "version": "0.1.0",
  "description": "ThoughtLite skin for DeepSeek Harness — a monochrome, serif-on-paper editorial repaint of the desktop GUI, ported from the astro-theme-thought-lite design language.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "fixtures",
    "preview",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts",
    "test",
    "docs"
  ],
  "scripts": {
    "build": "node src/build.mjs",
    "verify": "node test/verify.mjs",
    "preflight": "node scripts/preflight.mjs",
    "graph": "node scripts/graph-probe.mjs",
    "check": "node src/build.mjs && node test/verify.mjs",
    "prepublishOnly": "node src/build.mjs && node test/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "thought-lite",
    "astro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jov3c/dsh-theme-thought-lite.git"
  },
  "homepage": "https://github.com/Jov3c/dsh-theme-thought-lite#readme",
  "bugs": {
    "url": "https://github.com/Jov3c/dsh-theme-thought-lite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
